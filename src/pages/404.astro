---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles } from '../lib/articles';

const latest = (await getArticles()).slice(0, 4);
---

<BaseLayout title="페이지를 찾을 수 없습니다" noindex>
  <div class="container not-found">
    <p class="code">404</p>
    <h1>요청하신 페이지를 찾을 수 없습니다.</h1>
    <p>주소가 바뀌었거나 삭제된 기사일 수 있습니다. 검색으로 찾아보세요.</p>
    <form action="/search/" method="get" role="search">
      <label class="visually-hidden" for="nf-q">기사 검색</label>
      <input id="nf-q" name="q" type="search" placeholder="검색어" />
      <button type="submit">검색</button>
    </form>
    <p><a href="/">홈으로 가기 →</a></p>

    {
      latest.length > 0 && (
        <section>
          <div class="section-title">
            <h2>최신 기사</h2>
          </div>
          <ul class="grid">
            {latest.map((a) => (
              <li>
                <ArticleCard article={a} variant="card" />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .not-found {
    padding-top: 48px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    text-align: center;
  }
  .code {
    font-size: 56px;
    font-weight: 900;
    color: var(--brand);
    line-height: 1;
  }
  h1 {
    font-size: 22px;
  }
  form {
    display: flex;
    gap: 8px;
    max-width: 420px;
    width: 100%;
    margin: 8px auto 0;
  }
  input {
    flex: 1;
    min-width: 0;
    height: 44px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font: inherit;
  }
  button {
    height: 44px;
    padding: 0 16px;
    border: 0;
    border-radius: var(--radius);
    background: var(--brand-dark);
    color: #fff;
    font-weight: 700;
  }
  a {
    color: var(--brand);
  }
  section {
    margin-top: 40px;
    text-align: left;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    list-style: none;
  }
  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
