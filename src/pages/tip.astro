---
import StaticPage from '../components/StaticPage.astro';
import { site } from '../lib/site';

// site.json의 tipFormEndpoint에 폼 수신 주소(예: Formspree)를 넣으면 그 주소로 전송하고,
// 비어 있으면 제보 이메일(tipEmail)로 보낼 메일 작성 창을 엽니다.
const endpoint = site.tipFormEndpoint;
---

<StaticPage id="tip">
  <form
    class="tip-form"
    data-tip-form
    data-endpoint={endpoint}
    data-email={site.tipEmail}
    action={endpoint || `mailto:${site.tipEmail}`}
    method="post"
  >
    <h2>온라인 제보</h2>
    <div class="field">
      <label for="tip-name">이름 <small>(선택, 익명 가능)</small></label>
      <input id="tip-name" name="name" autocomplete="name" />
    </div>
    <div class="field">
      <label for="tip-contact">연락처 <small>(필수, 전화번호 또는 이메일)</small></label>
      <input id="tip-contact" name="contact" required autocomplete="email" />
    </div>
    <div class="field">
      <label for="tip-subject">제목 <small>(필수)</small></label>
      <input id="tip-subject" name="subject" required />
    </div>
    <div class="field">
      <label for="tip-message">제보 내용 <small>(필수)</small></label>
      <textarea id="tip-message" name="message" rows="8" required placeholder="언제, 어디서, 무슨 일이 있었는지 알려주세요."></textarea>
    </div>
    <input class="hp" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <fieldset class="consent">
      <legend>개인정보 수집·이용 동의 (필수)</legend>
      <ul>
        <li>수집 항목: 이름(선택), 연락처</li>
        <li>수집 목적: 제보 내용 확인 및 취재를 위한 연락</li>
        <li>보유 기간: 제보 처리 완료 후 1년 (관계 법령에 따라 보존이 필요한 경우 해당 기간)</li>
      </ul>
      <p>동의를 거부할 수 있으나, 거부 시 온라인 제보 접수가 제한됩니다. 자세한 내용은 <a href="/privacy/">개인정보처리방침</a>을 확인하세요.</p>
      <label class="check">
        <input type="checkbox" name="consent" value="동의" required />
        위 내용에 동의합니다.
      </label>
    </fieldset>

    <button type="submit">제보하기</button>
    <p class="status" role="status" aria-live="polite"></p>
  </form>
</StaticPage>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-tip-form]');
  const status = form?.querySelector<HTMLElement>('.status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !status) return;
    const data = new FormData(form);
    if (data.get('_gotcha')) return;

    const endpoint = form.dataset.endpoint;
    if (endpoint) {
      status.textContent = '전송 중입니다…';
      try {
        const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = '제보가 접수되었습니다. 소중한 제보 감사합니다.';
      } catch {
        status.textContent = `전송에 실패했습니다. ${form.dataset.email} 로 이메일 제보를 부탁드립니다.`;
      }
      return;
    }

    // 수신 주소가 없으면 메일 앱으로 작성 창을 엽니다.
    const body = [
      `이름: ${data.get('name') || '익명'}`,
      `연락처: ${data.get('contact')}`,
      '',
      String(data.get('message')),
    ].join('\n');
    const subject = `[기사제보] ${data.get('subject')}`;
    window.location.href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    status.textContent = '메일 앱에서 제보 메일을 보내 주세요. 메일 앱이 열리지 않으면 위 이메일 주소로 직접 보내 주세요.';
  });
</script>

<style>
  .tip-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    margin-top: 32px;
    padding: 24px 20px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }
  .tip-form h2 {
    font-size: 20px;
  }
  .field {
    display: grid;
    gap: 6px;
  }
  label {
    font-weight: 700;
    font-size: 15px;
  }
  label small {
    font-weight: 400;
    color: var(--muted);
  }
  input:not([type='checkbox']),
  textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font: inherit;
    font-size: 16px;
    background: #fff;
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .consent {
    margin: 0;
    padding: 14px 16px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: #fff;
    font-size: 14px;
    color: var(--ink-2);
  }
  .consent legend {
    padding: 0 4px;
    font-weight: 700;
    color: var(--ink);
  }
  .consent ul {
    padding-left: 18px;
    margin-bottom: 6px;
  }
  .consent a {
    color: var(--brand);
    text-decoration: underline;
  }
  .check {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 10px;
  }
  .check input {
    width: 18px;
    height: 18px;
  }
  button[type='submit'] {
    height: 48px;
    border: 0;
    border-radius: var(--radius);
    background: var(--brand-dark);
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
  }
  button[type='submit']:hover {
    background: var(--brand);
  }
  .status {
    font-size: 14px;
    color: var(--brand);
  }
</style>
