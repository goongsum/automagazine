---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fillSiteTokens } from '../lib/site';

interface Props {
  /** src/content/pages/ 안의 파일 이름 (확장자 제외) */
  id: string;
}

const { id } = Astro.props;
const page = await getEntry('pages', id);
if (!page) throw new Error(`고정 페이지 src/content/pages/${id}.md 를 찾을 수 없습니다.`);

// 본문 속 {{company}} 같은 표기를 site.json 값으로 채웁니다.
const html = fillSiteTokens(page.rendered?.html ?? '');
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <div class="container static-page">
    <header>
      <h1>{page.data.title}</h1>
    </header>
    <div class="prose">
      <Fragment set:html={html} />
    </div>
    <slot />
  </div>
</BaseLayout>

<style>
  .static-page {
    max-width: 840px;
    padding-top: 32px;
  }
  header {
    padding-bottom: 18px;
    margin-bottom: 28px;
    border-bottom: 2px solid var(--ink);
  }
  h1 {
    font-size: 28px;
    font-weight: 800;
  }
  .prose {
    font-size: 16px;
  }
  .prose :global(h2) {
    font-size: 19px;
  }
  .prose :global(h3) {
    font-size: 17px;
  }
</style>
