---
import type { Author } from '../lib/articles';

interface Props {
  author: Author;
  size?: number;
}
const { author, size = 48 } = Astro.props;
const { name, photo } = author.data;
---

{
  photo ? (
    <img class="avatar" src={photo} alt="" width={size} height={size} loading="lazy" style={`width:${size}px;height:${size}px`} />
  ) : (
    <span class="avatar avatar--initial" aria-hidden="true" style={`width:${size}px;height:${size}px;font-size:${Math.round(size * 0.42)}px`}>
      {name.slice(0, 1)}
    </span>
  )
}

<style>
  .avatar {
    flex: none;
    border-radius: 50%;
    object-fit: cover;
  }
  .avatar--initial {
    display: inline-grid;
    place-items: center;
    background: linear-gradient(135deg, var(--brand-dark), var(--brand));
    color: #fff;
    font-weight: 800;
  }
</style>
