---
import Logo from './Logo.astro';
import { site } from '../lib/site';

const year = new Date().getFullYear();

// 인터넷신문 법정 표기사항 — 값은 src/settings/site.json에서 수정합니다.
const rows: { label: string; value: string }[][] = [
  [
    { label: '제호', value: site.siteName },
    { label: '등록번호', value: site.registrationNumber },
    { label: '등록일', value: site.registrationDate },
    { label: '발행일', value: site.publishDate },
  ],
  [
    { label: '발행인', value: site.publisher },
    { label: '편집인', value: site.editor },
    { label: '청소년보호책임자', value: site.youthOfficer },
  ],
  [
    { label: '발행소', value: site.address },
    { label: '대표전화', value: site.phone },
    ...(site.fax ? [{ label: '팩스', value: site.fax }] : []),
    { label: '이메일', value: site.email },
  ],
  [
    { label: '운영', value: site.company },
    { label: '사업자등록번호', value: site.businessNumber },
  ],
];

const social = [
  { name: '유튜브', href: site.social.youtube },
  { name: '인스타그램', href: site.social.instagram },
  { name: '페이스북', href: site.social.facebook },
  { name: '네이버 블로그', href: site.social.naverBlog },
].filter((s) => s.href);
---

<footer class="site-footer">
  <nav class="footer-links" aria-label="사이트 정보">
    <div class="container">
      <ul>
        <li><a href="/about/">회사소개</a></li>
        <li><a href="/tip/">기사제보</a></li>
        <li><a href="/about/#ad">광고문의</a></li>
        <li><a href="/privacy/"><strong>개인정보처리방침</strong></a></li>
        <li><a href="/youth-policy/">청소년보호정책</a></li>
        <li><a href="/terms/">이용약관</a></li>
        <li><a href="/reporter/">기자 소개</a></li>
        <li><a href="/rss.xml">RSS</a></li>
      </ul>
    </div>
  </nav>

  <div class="container footer-body">
    <div class="footer-brand">
      <Logo inverse />
      {
        social.length > 0 && (
          <ul class="footer-social">
            {social.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener">
                  {s.name}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="footer-info">
      {
        rows.map((row) => (
          <p>
            {row.map((item) => (
              <span>
                <b>{item.label}</b> {item.value}
              </span>
            ))}
          </p>
        ))
      }
      <p class="footer-copy">
        {site.siteName}의 모든 콘텐츠(기사·사진·영상)는 저작권법의 보호를 받으며, 무단 전재·복사·배포 등을 금합니다.
      </p>
      <p class="footer-copy">Copyright © {year} {site.siteNameEn}. All rights reserved.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 56px;
    background: #0d1b2e;
    color: rgba(255, 255, 255, 0.72);
    font-size: 13px;
  }
  .footer-links {
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .footer-links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    padding: 14px 0;
    list-style: none;
  }
  .footer-links a {
    color: rgba(255, 255, 255, 0.88);
  }
  .footer-links a:hover {
    color: #fff;
  }
  .footer-links strong {
    color: #fff;
  }
  .footer-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    padding-top: 24px;
    padding-bottom: 36px;
  }
  .footer-social {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 14px;
    list-style: none;
  }
  .footer-social a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .footer-info p {
    line-height: 1.75;
  }
  .footer-info span {
    display: inline-block;
    margin-right: 14px;
  }
  .footer-info b {
    color: rgba(255, 255, 255, 0.5);
    font-weight: 500;
    margin-right: 2px;
  }
  .footer-copy {
    margin-top: 10px;
    color: rgba(255, 255, 255, 0.5);
  }
  .footer-copy + .footer-copy {
    margin-top: 0;
  }
  @media (min-width: 900px) {
    .footer-body {
      grid-template-columns: 220px 1fr;
      gap: 32px;
    }
  }
</style>
